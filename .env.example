# Supabase — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — test mode keys for dev; live keys only at real deploy
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_ID=

# Resend — transactional email (magic link delivery doubles as receipt/welcome)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin — comma-separated emails allowed into /admin (Ryan + Chris)
ADMIN_EMAILS=

# Booking tool link (Calendly/Acuity/etc — TBD per spec, plain link for now)
NEXT_PUBLIC_BOOKING_URL=

# Zapier "Catch Hook" URL that receives every new RSVP (step 1). Unset = leads
# are still saved and queued in lead_outbox, just not sent anywhere.
ZAPIER_LEADS_WEBHOOK_URL=

# Meta Conversions API - server-side Lead for the UNSTUCK dataset only.
# Unset = nothing is sent. Token: Events Manager > UNSTUCK dataset > Settings >
# Conversions API > Generate access token. Never commit it.
META_DATASET_ID=
META_CAPI_TOKEN=
# Testing only: the code from Events Manager > Test events. Remove for live events.
META_TEST_EVENT_CODE=
# Optional override; defaults to the current Graph API version (v26.0).
META_GRAPH_VERSION=

# Open signup: when "true", an email with no access grant is sent a real emailed
# magic link (verifying inbox ownership) instead of being turned away. A confirmed
# signup is reported to Meta as one Lead and lands on /purchase until granted
# access. Unset/false = unchanged behavior. Needs working auth email delivery
# (custom SMTP in Supabase) before turning on.
ALLOW_SIGNUP_LINKS=
